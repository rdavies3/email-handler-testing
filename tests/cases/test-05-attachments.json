{
  "id": "05",
  "name": "Attachments stored as Attachment records",
  "category": "basic-creation",
  "description": "Verifies that email attachments are stored as distinct Attachment records linked to the EmailMessage via ParentId",
  "emailProperties": {
    "to": "{{primary_email}}",
    "subject": "Test-05-{{timestamp}}",
    "textBody": "This email has attachments for test 05.",
    "htmlBody": "<p>This email has attachments for test 05.</p>",
    "attachments": [
      {
        "filename": "test-small.txt",
        "path": "generated-emails/attachments/test-small.txt",
        "contentType": "text/plain"
      },
      {
        "filename": "test-1mb.pdf",
        "path": "generated-emails/attachments/test-1mb.pdf",
        "contentType": "application/pdf"
      }
    ],
    "inlineImages": [],
    "fromNameOverride": null
  },
  "sendMethod": "eml",
  "preconditions": [],
  "verification": {
    "type": "case-created",
    "queries": [
      {
        "object": "Case",
        "filter": "Subject = 'Test-05-{{timestamp}}'",
        "assertions": [
          { "field": "Subject", "operator": "equals", "value": "Test-05-{{timestamp}}" },
          { "field": "Id", "operator": "not_null" }
        ]
      },
      {
        "object": "Attachment",
        "filter": "ParentId = '{{caseId}}'",
        "assertions": [
          { "field": "recordCount", "operator": "equals", "value": 2 },
          { "field": "Name", "operator": "contains", "value": "test-small" },
          { "field": "Name", "operator": "contains", "value": "test-1mb" }
        ]
      }
    ]
  }
}
